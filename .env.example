# Copy to .env (or set in the hosting environment). See docs/INTEGRATION.md.

# Public origin for canonical/hreflang links, JSON-LD and the sitemap.
NUXT_PUBLIC_SITE_URL=https://microfinance.uz
NUXT_PUBLIC_I18N_BASE_URL=https://microfinance.uz

# Server-only: where loan applications are forwarded. Empty = the form answers 503 (never a fake success).
NUXT_APPLICATIONS_ENDPOINT=
# Server-only: optional bearer token for that endpoint.
NUXT_APPLICATIONS_TOKEN=

# Server-only: email every application through Resend (https://resend.com/api-keys).
NUXT_RESEND_API_KEY=
# Comma-separated recipients.
NUXT_APPLICATIONS_EMAIL_TO=
# Sender on a domain verified in Resend. The default onboarding@resend.dev only delivers to your own Resend account email.
NUXT_APPLICATIONS_EMAIL_FROM="Microfinance.uz <onboarding@resend.dev>"

# Server-only: Bitrix24 inbound webhook (scope "crm"); every application becomes a CRM lead.
# Example: https://yourcompany.bitrix24.uz/rest/1/abc123xyz/  Keep it secret: anyone with it can edit the CRM.

# Public: Yandex Maps JavaScript API key (https://developer.tech.yandex.ru) for the branches map.
# It is sent to browsers, so restrict it to the site domain (HTTP Referer) in the developer console.
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=
